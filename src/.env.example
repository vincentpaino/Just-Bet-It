# Copy this file to .env and fill in your own real values.
# Never commit .env itself — only this .env.example file should be in git.

# The Odds API — https://the-odds-api.com
# Only needed by whoever runs the weekly props job (500 free credits/month).
ODDS_API_KEY=your_odds_api_key_here
CFBD_API_KEY=your_real_CFBD_KEY

# PostgreSQL connection
# Shared team database (Neon): paste the connection string from Cody here.
# When DATABASE_URL is set it's used and the DB_* lines below are ignored.
# DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# Local database (only if DATABASE_URL is not set).
# On macOS with a local Homebrew install, DB_USER is usually your Mac
# username (e.g. run `whoami` in Terminal to check), and DB_PASSWORD can
# be left blank if you haven't set one.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=just_bet_it
DB_USER=your_local_username_here
DB_PASSWORD=